#!/usr/bin/env node

/**
 * Claudex — Claude Code with any LLM
 *
 * If dist/cli.mjs exists (built), run that.
 * Otherwise, tell the user to build first or use `bun run dev`.
 */

import { existsSync } from 'fs'
import { join, dirname } from 'path'
import { fileURLToPath, pathToFileURL } from 'url'
import { spawn } from 'child_process'

const __dirname = dirname(fileURLToPath(import.meta.url))
const distPath = join(__dirname, '..', 'dist', 'cli.mjs')

if (process.argv[2] === 'telegram') {
  // `claudex telegram ...` is documented everywhere (README, telegram-gateway/README.md,
  // and the gateway's own runtime messages) as the way to manage the Telegram gateway,
  // but the actual implementation lives in the separate claudex-telegram bin. Delegate
  // instead of making every doc string and user-facing error message wrong.
  const child = spawn(
    process.execPath,
    [join(__dirname, 'claudex-telegram'), ...process.argv.slice(3)],
    { stdio: 'inherit' },
  )
  child.on('exit', code => process.exit(code ?? 1))
} else if (existsSync(distPath)) {
  await import(pathToFileURL(distPath).href)
} else {
  console.error(`
  claudex: dist/cli.mjs not found.

  Build first:
    bun run build

  Or run directly with Bun:
    bun run dev

  See README.md for setup instructions.
`)
  process.exit(1)
}
